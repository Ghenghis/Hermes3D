# =============================================================================
# Hermes3D-OS Lite — example environment file
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every value here is OPTIONAL — sensible defaults are shipped.
# =============================================================================

# ---- Proof signing (REQUIRED if you produce shareable proofs) ----
# 32+ bytes, random. Do NOT use the default in production.
HERMES3D_PROOF_KEY=hermes3d-default-proof-key-not-secret

# ---- Persistent state paths ----
HERMES3D_QUEUE=./var/queue.json
HERMES3D_SPOOLS=./var/spools.json
HERMES3D_HISTORY=./var/history.jsonl
HERMES3D_SKILLS=./var/skills.json
HERMES3D_WORKFLOWS=./var/workflows
HERMES3D_BACKUP_DIR=./var/backups

# ---- REST API ----
# Bearer token for the FastAPI server. Empty = open mode (LAN-only!)
HERMES3D_API_TOKEN=

# ---- Notifications (Discord / Slack / Generic) ----
# Each is independent; leave blank to disable that channel.
HERMES3D_DISCORD_WEBHOOK=
HERMES3D_SLACK_WEBHOOK=
HERMES3D_GENERIC_WEBHOOK=

# ---- Moonraker ----
# Per-printer URLs are baked into printer_profiles.py; this is a
# default API key for any Moonraker requiring auth.
MOONRAKER_API_KEY=

# ---- OctoPrint (alternative transport) ----
OCTOPRINT_API_KEY=

# ---- Obico (closed-loop AI failure detection) ----
OBICO_BASE_URL=
OBICO_API_KEY=

# ---- Local LLM (Ollama or LM Studio, fully optional) ----
# select_provider() auto-detects the first reachable backend; force one via
# HERMES3D_LLM_PROVIDER=ollama|lmstudio|vllm|llamacpp|openrouter.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# LM Studio (OpenAI-compatible local server). Start with: lms server start
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=lm-studio   # any non-empty string; LM Studio ignores it

# ---- Cost defaults ----
HERMES3D_PRICE_PER_KWH_USD=0.16

# ---- UI / development ----
GRADIO_SERVER_PORT=7860
HERMES3D_API_PORT=7861
HERMES3D_LOG_LEVEL=INFO

# ---- Hermes Agent code runners (OpenCode / OpenHands) ----
# Real values live in G:/private/.env. Leave binaries blank until installed.
HERMES3D_OPENCODE_SOURCE=G:/Github/opencode-dev
HERMES3D_OPENCODE_BIN=
HERMES3D_OPENHANDS_SOURCE=G:/Github/OpenHands
HERMES3D_OPENHANDS_BIN=
HERMES3D_AGENT_SANDBOX_MODE=docker
HERMES3D_AGENT_SANDBOX_IMAGE=
HERMES3D_AGENT_SANDBOX_NETWORK=none
HERMES3D_AGENT_SANDBOX_TIMEOUT_SECONDS=900
HERMES3D_AGENT_SANDBOX_ALLOW_INTERNET=0
