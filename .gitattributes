# Force LF line endings for source / config files so ruff format --check passes
# on Linux CI regardless of contributor OS.

# Default: text auto-detect, normalized to LF in repo
* text=auto eol=lf

# Source code — always LF
*.py    text eol=lf
*.pyi   text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.md    text eol=lf
*.mmd   text eol=lf
*.txt   text eol=lf

# Windows scripts — keep CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.stl   binary
*.gcode binary
*.3mf   binary
*.bgcode binary
*.sig   binary
