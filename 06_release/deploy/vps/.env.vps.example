# Copy to 06_release/deploy/vps/.env on the VPS and replace every placeholder.

# Public DNS name pointed at the VPS. Example shape only; use your real domain.
HERMES_PUBLIC_DOMAIN=hermes.example.invalid

# Tailscale-resolved Ollama endpoint on the local inference PC.
OLLAMA_BASE_URL=http://gaming-pc.tailnet-name.ts.net:11434

# Database password for the postgres:16-alpine service.
POSTGRES_PASSWORD=replace-with-random-postgres-password

# Redis password for the redis:7-alpine service.
REDIS_PASSWORD=replace-with-random-redis-password

# HMAC proof key used by Hermes3D. Generate a long random value per deployment.
HERMES3D_PROOF_KEY=replace-with-random-proof-key

# Ephemeral or reusable Tailscale auth key for the VPS sidecar.
TS_AUTHKEY=replace-with-tailnet-auth-key

# Backblaze B2 account id for Restic repository access.
B2_ACCOUNT_ID=replace-with-b2-account-id

# Backblaze B2 application key for Restic repository access.
B2_ACCOUNT_KEY=replace-with-b2-application-key

# Restic repository encryption password. Store a recovery copy offline.
RESTIC_PASSWORD=replace-with-random-restic-password

# Restic repository target, usually b2:bucket-name:path.
RESTIC_REPOSITORY=b2:replace-with-bucket-name:hermes3d-vps
