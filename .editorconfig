root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{json,yaml,yml,toml,ini,cfg}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{sh,bash}]
end_of_line = lf
indent_size = 2

[Makefile]
indent_style = tab
