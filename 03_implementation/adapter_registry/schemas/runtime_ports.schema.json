{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes3d://adapter_registry/schemas/runtime_ports.schema.json",
  "title": "runtime ports config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api",
    "web"
  ],
  "properties": {
    "api": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 7862
    },
    "web": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 5173
    },
    "camera_proxy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8080
    },
    "telemetry": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 9090
    },
    "model_llm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 11434
    }
  }
}
