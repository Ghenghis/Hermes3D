{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes3d://adapter_registry/schemas/blender_mcp.schema.json",
  "title": "Blender MCP provider config",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_id"],
  "properties": {
    "provider_id": {"type": "string", "enum": ["ahujasid", "vxai", "custom"], "description": "Selected MCP provider per BLENDER_MCP_PROVIDER_MANAGER.md."},
    "endpoint": {"type": ["string", "null"], "default": null, "description": "Optional override of the provider's default endpoint."},
    "version_pin": {"type": ["string", "null"], "default": null},
    "checksum": {"type": ["string", "null"], "default": null, "description": "Optional sha256 of the provider artifact for rollback safety."}
  }
}
