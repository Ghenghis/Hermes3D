{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes3d://adapter_registry/schemas/orca_slicer.schema.json",
  "title": "OrcaSlicer adapter config",
  "type": "object",
  "additionalProperties": false,
  "required": ["exe_path"],
  "properties": {
    "exe_path": {"type": "string", "minLength": 1},
