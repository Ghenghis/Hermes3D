{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes3d://adapter_registry/schemas/freecad_bridge.schema.json",
  "title": "freecad bridge config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional local or service endpoint URL."
    },
    "executable_path": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional absolute executable path."
    },
    "config_path": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional config or profile path."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "default": 5000
    },
    "verify": {
      "type": "object",
      "description": "Real probe metadata consumed by scripts/verify_modelers.py. No fake or simulated checks.",
      "additionalProperties": false,
      "required": ["modeler_id", "kind", "version_probe", "install_check", "runtime_check"],
      "properties": {
        "modeler_id": {"type": "string", "const": "freecad"},
        "kind": {"type": "string", "enum": ["cli", "python_import"], "default": "cli"},
        "version_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "args"],
          "properties": {
            "mode": {"type": "string", "enum": ["cli_args", "python_import"]},
            "args": {"type": "array", "items": {"type": "string"}, "default": ["--version"]},
            "executable_candidates": {
              "type": "array",
              "items": {"type": "string"},
              "default": [
                "C:/Program Files/FreeCAD 1.0/bin/FreeCAD.exe",
                "C:/Program Files/FreeCAD 0.21/bin/FreeCAD.exe",
                "FreeCAD",
                "freecad"
              ]
            },
            "import_module": {"type": "string", "default": "FreeCAD"},
            "version_regex": {"type": "string", "default": "FreeCAD\\s+(\\d+\\.[0-9]+(?:\\.[0-9]+)?)"},
            "timeout_s": {"type": "integer", "minimum": 1, "maximum": 60, "default": 12}
          }
        },
        "install_check": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable_must_exist": {"type": "boolean", "default": true},
            "required_capabilities": {
              "type": "array",
              "items": {"type": "string"},
              "default": ["parametric_cad", "step_iges_io", "python_scripting"]
            }
          }
        },
        "runtime_check": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "help_args": {"type": "array", "items": {"type": "string"}, "default": ["--help"]},
            "expected_help_substring": {"type": "string", "default": "FreeCAD"},
            "timeout_s": {"type": "integer", "minimum": 1, "maximum": 60, "default": 15}
          }
        }
      }
    }
  }
}
