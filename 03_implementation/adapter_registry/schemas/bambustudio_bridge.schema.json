{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes3d://adapter_registry/schemas/bambustudio_bridge.schema.json",
  "title": "bambustudio bridge config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional local or service endpoint URL."
    },
    "executable_path": {
      "type": [
        "string",
        "null"
      ],
      "default": "C:/Program Files/Bambu Studio/bambu-studio.exe",
      "description": "Bambu Studio Windows launcher path (boolean-presence check only; no launch)."
    },
    "config_path": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional config or profile path."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "default": 5000
    },
    "source_repo": {
      "type": [
        "string",
        "null"
      ],
      "default": "https://github.com/bambulab/BambuStudio.git",
      "description": "Upstream git repo (used by verify_gen3d.py via git ls-remote, no clone)."
    },
    "pip_package": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Bambu Studio is a desktop app; no pip package."
    },
    "weights_cache_dirs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Bambu Studio is a slicer; no model weights are required."
    }
  }
}
