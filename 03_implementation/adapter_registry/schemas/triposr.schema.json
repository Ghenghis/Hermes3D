{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes3d://adapter_registry/schemas/triposr.schema.json",
  "title": "triposr config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional local or service endpoint URL."
    },
    "executable_path": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional absolute executable path."
    },
    "config_path": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional config or profile path."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "default": 5000
    },
    "source_repo": {
      "type": [
        "string",
        "null"
      ],
      "default": "https://github.com/VAST-AI-Research/TripoSR.git",
      "description": "Upstream git repo (used by verify_gen3d.py via git ls-remote, no clone)."
    },
    "pip_package": {
      "type": [
        "string",
        "null"
      ],
      "default": "triposr",
      "description": "Optional pip package name to probe via 'pip show' (no install)."
    },
    "weights_cache_dirs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "~/.cache/huggingface/hub/models--stabilityai--TripoSR",
        "~/.cache/triposr"
      ],
      "description": "Boolean-presence weight cache locations. Verifier never downloads."
    }
  }
}
