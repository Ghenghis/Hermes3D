{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes3d://adapter_registry/schemas/blender.schema.json",
  "title": "Blender adapter config",
  "type": "object",
  "additionalProperties": false,
  "required": ["exe_path"],
  "properties": {
    "exe_path": {"type": "string", "minLength": 1, "description": "Absolute path to the Blender executable."},
    "headless_capable": {"type": "boolean", "default": true, "description": "Whether `blender --background --python` is supported on this build."},
    "scripts_dir": {"type": ["string", "null"], "default": null}
  }
}
