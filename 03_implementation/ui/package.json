{
  "name": "hermes3d-ui-final",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes3D-OS local-first dashboard backed by the Hermes3D GUI API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:visual": "playwright test --config=playwright.e2e.config.ts",
    "test:visual:update": "playwright test --config=playwright.e2e.config.ts",
    "test:breadth": "playwright test --config=playwright.breadth.config.ts"
  },
  "dependencies": {
    "lucide-react": "0.451.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "recharts": "2.13.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.19.18",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "8.0.10",
    "vitest": "^2.1.5"
  }
}
