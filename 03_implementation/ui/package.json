{
  "name": "hermes3d-ui-final",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes3D-OS local-first dashboard backed by the Hermes3D GUI API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "tsc --noEmit",
    "test:visual": "playwright test --config=playwright.e2e.config.ts",
    "test:visual:update": "playwright test --config=playwright.e2e.config.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "lucide-react": "0.451.0",
    "recharts": "2.13.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8"
  }
}
