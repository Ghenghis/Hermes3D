node_modules/
dist/
dist-breadth/
.vite/
*.log

# tsc -b incremental build artifacts
*.tsbuildinfo

# tsc emit of vite.config.ts (we run vite via the .ts source, no need to commit the .js)
vite.config.js
vite.config.d.ts

# Playwright runtime outputs (baselines under tests/visual/*-snapshots/ ARE committed)
artifacts/
test-results/
playwright-report/

# W18-A10 PICKUP visual oracle runtime outputs:
#  - __refs_pickup__ is a regenerable mirror of Images-GUI/ (globalSetup re-creates it)
#  - observed-pickup / diffs-pickup are per-run screenshots; the source of
#    truth is W18_A10_PICKUP_SUMMARY.json which the reporter writes alongside.
tests/e2e/__refs_pickup__/
tests/visual-proof/observed-pickup/
tests/visual-proof/diffs-pickup/

# Source component folder named "artifacts" is part of the codebase, not a build output.
!src/components/artifacts/
!src/components/artifacts/**
