node_modules/
dist/
dist-breadth/
.vite/
*.log

# tsc -b incremental build artifacts
*.tsbuildinfo

# tsc emit of vite.config.ts (we run vite via the .ts source, no need to commit the .js)
vite.config.js
vite.config.d.ts

# Playwright runtime outputs (baselines under tests/visual/*-snapshots/ ARE committed)
artifacts/
test-results/
playwright-report/

# Source component folder named "artifacts" is part of the codebase, not a build output.
!src/components/artifacts/
!src/components/artifacts/**
